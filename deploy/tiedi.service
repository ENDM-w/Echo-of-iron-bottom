# 铁底湾后端 systemd 单元 —— 复制到服务器 /etc/systemd/system/tiedi.service
#
#   sudo cp deploy/tiedi.service /etc/systemd/system/tiedi.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now tiedi
#   日志：journalctl -u tiedi -f
#
# 密钥纪律：DEEPSEEK_API_KEY 只经 EnvironmentFile=/etc/tiedi.env 注入；
# 文件 root:root 0600。服务不以 root 运行，且 EnvironmentFile 可缺省。

[Unit]
Description=铁底湾的回响 IV backend (uvicorn, serves /tiedi API for fuwenji.asia)
After=network.target

[Service]
Type=simple
User=tiedi
Group=tiedi
WorkingDirectory=/opt/tiedi
# StateDirectory 由 systemd 创建于 /var/lib/tiedi；不随代码更新覆盖。
StateDirectory=tiedi
StateDirectoryMode=0750
Environment=IBS_DB_PATH=/var/lib/tiedi/state.sqlite3
Environment=IBS_REPORTS_DIR=/var/lib/tiedi/reports
EnvironmentFile=-/etc/tiedi.env
UMask=0077
ExecStart=/opt/tiedi/.venv/bin/python -m uvicorn iron_bottom_sound.api:app --app-dir backend/src --host 127.0.0.1 --port 8001 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectClock=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/var/lib/tiedi

[Install]
WantedBy=multi-user.target
